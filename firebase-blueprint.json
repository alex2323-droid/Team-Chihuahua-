{
  "entities": {
    "Seller": {
      "title": "Seller",
      "description": "Information and catalog configuration for a registered seller",
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "description": "Unique username for the seller"
        },
        "password": {
          "type": "string",
          "description": "Password for the seller"
        },
        "catalog": {
          "type": "object",
          "description": "Complete catalog data including business profile, settings, and products list"
        }
      },
      "required": ["username", "password", "catalog"]
    },
    "Catalog": {
      "title": "Catalog",
      "description": "Public catalog data stored under its unique ID for customers to access",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "business": {
          "type": "object"
        },
        "settings": {
          "type": "object"
        },
        "products": {
          "type": "array"
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": ["id", "business", "settings", "products"]
    }
  },
  "firestore": {
    "sellers/{username}": {
      "schema": "Seller",
      "description": "Collection of registered sellers and their respective catalogs"
    },
    "catalogs/{catalogId}": {
      "schema": "Catalog",
      "description": "Publicly accessible catalogs for clients/customers"
    }
  }
}
