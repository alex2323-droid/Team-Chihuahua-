rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Sellers collection
    match /sellers/{username} {
      // Anyone can get a seller's profile/catalog to check username/view catalog
      allow get: if true;
      // Anyone can register as a seller
      allow create: if true;
      // Registered sellers can update their own catalogs
      allow update, delete: if true;
    }

    // Catalogs collection (public views)
    match /catalogs/{catalogId} {
      // Anyone can read a public catalog
      allow read: if true;
      // Anyone (guest or registered seller) can publish or update their catalog
      allow write: if true;
    }
  }
}
