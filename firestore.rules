rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Test connection doc
    match /test/connection {
      allow read: if true;
    }

    // Catalogs Collection: Public read for customers, controlled write
    match /catalogs/{catalogId} {
      function isValidCatalog(data) {
        return data.keys().hasAll(['id', 'business', 'settings', 'products']) &&
               data.id is string && isValidId(data.id) &&
               data.business is map &&
               data.business.name is string && data.business.name.size() > 0 && data.business.name.size() <= 100 &&
               data.business.whatsapp is string && data.business.whatsapp.size() > 0 && data.business.whatsapp.size() <= 30 &&
               data.settings is map &&
               data.products is list && data.products.size() <= 500;
      }

      // Public customers can view individual catalog documents
      allow get: if isValidId(catalogId);
      // Listing catalogs is prohibited to prevent whole database scraping
      allow list: if false;

      // Create new catalog
      allow create: if isValidId(catalogId) &&
                       isValidCatalog(incoming()) &&
                       incoming().id == catalogId;

      // Update existing catalog
      allow update: if isValidId(catalogId) &&
                       isValidCatalog(incoming()) &&
                       incoming().id == existing().id;

      // Delete catalog
      allow delete: if isSignedIn();
    }

    // Sellers Collection: Private seller information
    match /sellers/{sellerId} {
      function isValidSeller(data) {
        return data.keys().hasAll(['id', 'username', 'name']) &&
               data.id is string && isValidId(data.id) &&
               data.username is string && data.username.size() > 0 && data.username.size() <= 50 &&
               data.name is string && data.name.size() > 0 && data.name.size() <= 100;
      }

      allow get: if isValidId(sellerId) && (
        !isSignedIn() || request.auth.uid == sellerId || resource.data.id == sellerId
      );
      allow list: if false;
      allow create: if isValidId(sellerId) && isValidSeller(incoming());
      allow update: if isValidId(sellerId) && isValidSeller(incoming()) && incoming().id == existing().id;
      allow delete: if false;
    }
  }
}
